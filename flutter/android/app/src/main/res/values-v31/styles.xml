<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DiceX: Android 12+ draws its own launch screen from these: icon in the middle, name under
         it. MainActivity keeps it up for at least two seconds, like the Windows splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/dicex_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/dicex_splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/dicex_splash_branding</item>
    </style>
</resources>
