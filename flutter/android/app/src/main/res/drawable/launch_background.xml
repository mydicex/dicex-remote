<?xml version="1.0" encoding="utf-8"?>
<!-- DiceX: the launch screen up to Android 11 (Android 12+ uses values-v31/styles.xml).
     Images and colours come from brand/tools/make-android-splash.ps1; drawable-night-* holds the
     dark versions. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dicex_splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/dicex_splash" />
    </item>
</layer-list>
